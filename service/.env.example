# Copy to .env (gitignored) for running the service locally, outside Docker.
# `docker compose` (the real deployment) reads deploy/.env instead -- this
# file is only consulted if you load it yourself, e.g. `uv run --env-file .env ...`.

# Flagsmith server-side key -- use the DEVELOPMENT environment's key here,
# never production's. deploy/.env on the homeserver holds the production
# key; this is a separate Flagsmith Environment so flipping a flag while
# testing locally can't affect the live site.
FLAGSMITH_SERVER_ENV_KEY=

# Hugging Face archive pipeline (M9) -- fine-grained token, WRITE-scoped to
# ONLY the target dataset repo (kept private, no account-wide token type).
HF_TOKEN=
HF_DATASET_REPO=

# Archiver's own healthchecks.io dead-man check -- optional, separate from
# the poller's TT_DEADMAN_PING_URL.
TT_ARCHIVE_DEADMAN_PING_URL=
