# Copy to .env.local (gitignored) and fill in the deployed backend's public
# URL. Never commit the real value here -- see work-docs' scrub gate.
VITE_API_BASE_URL=

# Flagsmith client-side Environment ID (Environment Settings -> SDK Keys).
# This is the public/client key, safe to expose in the built bundle -- not
# the server-side key (that one lives in deploy/.env only).
VITE_FLAGSMITH_ENV_ID=
