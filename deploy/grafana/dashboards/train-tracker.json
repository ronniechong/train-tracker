      "type": "timeseries",
      "title": "Archiver: upload retry failures (last pass)",
      "description": "Every failed upload attempt in the last pass, including ones that eventually succeeded on retry (see upload.py's UploadStats).",
      "gridPos": {
        "x": 12,
        "y": 92,
        "w": 12,
        "h": 8
      },
      "datasource": {
