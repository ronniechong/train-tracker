    {
      "id": 21,
      "type": "timeseries",
      "title": "Delay model: time since last retrain attempt",
      "description": "Fed by node_exporter's textfile collector, written on every retrain attempt (pass or fail) -- not a live scrape. No dedicated alert (old model keeps serving predictions if a retrain is skipped); watch alongside panel 22's eval gate result.",
      "gridPos": {
        "x": 0,
        "y": 100,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
