            "uid": "PBFA97CFB590B2093"
          },
          "expr": "time() - delay_model_last_run_timestamp_seconds",
          "legendFormat": "time since last run",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Delay model: eval gate result (last attempt)",
      "description": "1=passed baseline gate, wrote new model. 0=failed gate, old model kept serving.",
