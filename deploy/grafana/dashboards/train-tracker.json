{
  "title": "train-tracker",
  "uid": "train-tracker",
  "schemaVersion": 39,
  "version": 13,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "train-tracker"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Feed data age (seconds since header last advanced)",
      "description": "Alert threshold is 300s (5min); NEVER driven off entity count -- a legitimate zero-entity overnight cycle still advances the header and does not show here as stale.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "time() - traintracker_feed_last_changed_timestamp_seconds",
          "legendFormat": "{{job}} {{feed}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Poll cycle rate, by result",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (result) (rate(traintracker_poll_cycles_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "x-rate-limit remaining (lowest window per cycle)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "traintracker_rate_limit_remaining",
          "legendFormat": "remaining",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "TU/VP discrepancy ratio",
      "description": "Decision gate: <2% -> freshest-per-field merge rule stands (settled). >=2% -> dedicated reconciliation-formula session.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "rate(traintracker_discrepancy_events_total[$__rate_interval]) / rate(traintracker_poll_cycles_total{result=\"ok\"}[$__rate_interval])",
          "legendFormat": "discrepancy ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ghost episodes, by City Loop containment",
      "description": "Decision gate: if ~99% of ghost events are loop_contained=true -> dedicated 'in loop, position unavailable' state.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (loop_contained) (rate(traintracker_ghost_events_total[$__rate_interval]))",
          "legendFormat": "loop_contained={{loop_contained}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Circuit breaker backoff active",
      "description": "1 while backing off. Staleness/outage alerts AND against this being 0, so a legitimate backoff episode is never read as an outage.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "traintracker_backoff_active",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "text",
      "title": "Coverage by band -- deferred",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Not implemented yet.** Computing live coverage-vs-schedule requires loading the pinned static snapshot inside the running poller to know which trips are scheduled right now -- a new integration surface not wired up yet (the static-snapshot fetch job itself also has no production entrypoint). Flagged and deferred (2026-07-21) rather than built half-considered."
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Container memory (working set)",
      "description": "Filtered to this project's own containers -- the shared cAdvisor instance also reports every other container on the host. `name=~` regex assumes docker-compose's default container naming; adjust if the shared instance's compose project name differs.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "container_memory_working_set_bytes{name=~\".*(poller|egress-proxy).*\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Container CPU usage",
      "description": "Filtered to this project's own containers -- see panel 8's note on the name filter.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".*(poller|egress-proxy).*\"}[$__rate_interval])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container last start time (restart proxy)",
      "description": "cAdvisor has no direct 'restart count' metric (that's a Kubernetes-only concept). A drop then jump in this value for a container is a restart -- an approximation, not a counter, until/unless something better is wired up. Filtered to this project's own containers, see panel 8's note.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "container_start_time_seconds{name=~\".*(poller|egress-proxy).*\"} * 1000",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Disk headroom (root filesystem)",
      "description": "Alert threshold: <15% free (confirmed 2026-07-20).",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"} * 100",
          "legendFormat": "free %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Rate-limited requests (possible DDoS/abuse)",
      "description": "Alert threshold (rate-limit-abuse): >50 rejections in 5min, either scope. Legitimate traffic should read ~0 here -- any sustained nonzero line is either a misbehaving client or real abuse.",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (job, endpoint, scope) (rate(traintracker_rate_limited_requests_total[$__rate_interval]))",
          "legendFormat": "{{job}} {{endpoint}}/{{scope}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Poller scrape target up",
      "description": "Alert (poller-down): fires when this reads 0 for >2m -- Prometheus can no longer scrape the poller container at all. Distinct from panel 1's feed-staleness -- this is 'is the container reachable', that one is 'are the upstream feeds fresh'.",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "up{job=\"train-tracker-poller\"}",
          "legendFormat": "up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "HTTP requests/sec, by route + status",
      "description": "Added 2026-08-01: per-route request/status visibility that didn't exist before (only 429 rejections were tracked). A route silently 500ing, or getting hammered below the rate-limit threshold, is now visible here.",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (job, route, status) (rate(traintracker_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{job}} {{route}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "HTTP request latency (p50/p95), by route",
      "description": "Time to first byte, not full completion -- /api/stream is a long-lived SSE connection that would otherwise show up as an hours-long outlier (see http_metrics.py's own docstring for why).",
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "histogram_quantile(0.50, sum by (le, job, route) (rate(traintracker_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{job}} {{route}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job, route) (rate(traintracker_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{job}} {{route}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "HTTP 5xx count (last 5m)",
      "description": "Alert (http-5xx-rate): fires when this exceeds 10 for 2m straight. Same query as the alert rule, incl. the `or vector(0)` fallback -- the {status=~\"5..\"} series doesn't exist in Prometheus until the first 5xx happens.",
      "gridPos": {
        "x": 0,
        "y": 76,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (job) (increase(traintracker_http_requests_total{status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "{{job}} 5xx count",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Archiver: days pending (backlog)",
      "description": "Days pending threshold for the pending>2 Slack alert. Fed by node_exporter's textfile collector, not a live scrape -- the archiver is a one-shot nightly job, so this only updates once/night. As of the mode label (metrics.py), this also covers vline-archiver once its file is scraped from the same textfile directory.",
      "gridPos": {
        "x": 0,
        "y": 84,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "archive_days_pending",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Archiver: oldest pending day age",
      "description": "Age of the oldest currently-unarchived day. Alert threshold: 53 days (RETENTION_DAYS=60 minus the 7-day buffer in run.py's SAFETY_NET_DAYS) -- this panel and its alert always use the real code constant, not a design-doc figure that may be stale relative to a later retention change.",
      "gridPos": {
        "x": 12,
        "y": 84,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 23
              },
              {
                "color": "red",
                "value": 53
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "archive_days_pending_oldest_age_days",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Archiver: time since last completed run",
      "description": "Alert (archiver-missed-run): fires when this exceeds ~27h -- one nightly run (03:30) plus slack for a delayed cron/host restart, before treating it as a genuinely missed run.",
      "gridPos": {
        "x": 0,
        "y": 92,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 97200
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
