# Sole ingress into the `poller` service's FastAPI/SSE app. Listens on
# plain HTTP on an internal-only network — TLS termination happens on the
# reverse-ingress layer in front of this container, not here.
{
	auto_https off
	admin off

	# The `tailscale` sidecar shares this container's network namespace
	# (compose's `network_mode: service:caddy`), so every real Funnel
	# request arrives over loopback with X-Forwarded-For already set
	# correctly by tailscaled. Trusting 127.0.0.1 here is safe because
	# nothing but the sidecar can reach Caddy on loopback.
	servers {
		trusted_proxies static 127.0.0.1
	}
}

:8080 {
	encode gzip

	# Security headers applied to every response, including 404s and the
	# catch-all error handler. This is a GET-only JSON/SSE API, so
	# `default-src 'none'` is the correct CSP. `Cache-Control: no-store`
	# ensures `/api/state` is never cached stale. `-Server` strips
	# version-fingerprinting from the response.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Cache-Control no-store
		-Server
	}

	# This path is only ever served on :8081 below (tailnet-only, never
	# funnelled) — blocked here at the ingress so the public port cannot
	# reach it even if the app-level route exists underneath.
	@briefing_trigger path /briefing/trigger
	handle @briefing_trigger {
		respond 404
	}

	# SSE must never be buffered — flush every write immediately so deltas
	# reach the client as they're generated, not batched up.
	@stream path /api/stream
	handle @stream {
		reverse_proxy poller:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy poller:8000
	}
}

# On-demand briefing trigger (POST /briefing/trigger) — tailnet-only via
# `tailscale serve` (deploy/tailscale-entrypoint.sh), never funnelled to the
# public internet. This route spends real LLM budget and posts to Slack, so
# it relies on network-level isolation over an app-level bearer token.
# Nothing else is served on this port; keep the surface as narrow as the
# public one.
:8081 {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
		Cache-Control no-store
		-Server
	}

	@briefing_trigger path /briefing/trigger
	handle @briefing_trigger {
		reverse_proxy poller:8000
	}

	handle {
		respond 404
	}
}
